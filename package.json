{
  "name": "@darkmintis/dsh-device-fleet",
  "version": "0.1.0",
  "description": "Android device fleet cockpit for DeepSeek Harness: list phones and emulators, install, launch, screenshot, deep-link, and tail logcat over adb.",
  "author": "Darkmintis",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkmintis/dsh-device-fleet.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "adb",
    "android",
    "flutter",
    "emulator",
    "device-farm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "build": "node scripts/build-check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
